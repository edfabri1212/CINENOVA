@model CineNova.Models.Pelicula

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Titulo" class="form-label"></label>
    <input asp-for="Titulo" class="form-control cn-input"
           placeholder="Nombre de la película" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" rows="4"
              class="form-control cn-input"
              placeholder="Escribe la sinopsis de la película..."></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Anio" class="form-label"></label>
        <input asp-for="Anio" type="number" class="form-control cn-input" />
        <span asp-validation-for="Anio" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Duracion" class="form-label"></label>
        <input asp-for="Duracion" type="number" class="form-control cn-input" />
        <span asp-validation-for="Duracion" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Clasificacion" class="form-label"></label>
    <input asp-for="Clasificacion" class="form-control cn-input"
           placeholder="Ej. PG-13" />
    <span asp-validation-for="Clasificacion" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoriaId" class="form-label"></label>
    <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId"
            class="form-select cn-input">
        <option value="">Selecciona una categoría</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ImagenUrl" class="form-label"></label>
    <input asp-for="ImagenUrl" class="form-control cn-input"
           placeholder="https://ejemplo.com/portada.jpg" />
    <span asp-validation-for="ImagenUrl" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="VideoUrl" class="form-label"></label>
    <input asp-for="VideoUrl" class="form-control cn-input"
           placeholder="https://ejemplo.com/video" />
    <span asp-validation-for="VideoUrl" class="text-danger"></span>
</div>

<div class="form-check form-switch mb-3">
    <input asp-for="Estado" class="form-check-input" />
    <label asp-for="Estado" class="form-check-label"></label>
</div>
