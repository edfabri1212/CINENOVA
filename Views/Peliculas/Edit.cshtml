@model CineNova.Models.Pelicula

@{
    ViewData["Title"] = "Editar película";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="cn-form-card">
            <h2 class="fw-bold mb-2">Editar película</h2>
            <p class="text-secondary mb-4">Actualiza la información de la película.</p>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <partial name="_Form" model="Model" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-cn">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
