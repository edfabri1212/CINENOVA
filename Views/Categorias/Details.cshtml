@model CineNova.Models.Categoria

@{
    ViewData["Title"] = "Detalles de categoría";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="cn-form-card">
            <h2 class="fw-bold mb-4">Detalles de categoría</h2>

            <h4 class="text-danger">@Model.Nombre</h4>

            <hr class="border-secondary" />

            <dl class="row">
                <dt class="col-sm-4">Identificador</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@(Model.Descripcion ?? "Sin descripción")</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    @if (Model.Estado)
                    {
                        <span class="cn-badge-active">Activa</span>
                    }
                    else
                    {
                        <span class="cn-badge-inactive">Inactiva</span>
                    }
                </dd>

                <dt class="col-sm-4">Películas registradas</dt>
                <dd class="col-sm-8">@(Model.Peliculas?.Count ?? 0)</dd>
            </dl>

            <div class="d-flex gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-cn">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>
    </div>
</div>
